# Compiles the fixed-function emulation shaders of the bgfx backend into TRenderShaders.h.
# Run it after changing a .sc file (the header is committed, so builds do not need shaderc):
#
#   cmake -DSHADERC=<path to shaderc.exe> -P "Lib/Own/Engine Lib/Engine Lib/shaders/CompileShaders.cmake"
#
# shaderc comes from the vendored bgfx.cmake: Client/build-shaderc.ps1 builds it into build/shaderc.

if(NOT SHADERC)
    message(FATAL_ERROR "Pass -DSHADERC=<path to shaderc>")
endif()

set(_dir "${CMAKE_CURRENT_LIST_DIR}")
set(_bgfx_src "${_dir}/../../../../3rdParty/bgfx.cmake/bgfx/src")
set(_work "${_dir}/../../../../../build/shaders")
set(_header "${_dir}/../TRenderShaders.h")
file(MAKE_DIRECTORY "${_work}")

# Backend name, shaderc platform, shaderc profile.
set(_backends
    "dx11:windows:s_5_0"
    "spirv:linux:spirv"
    "glsl:linux:330")

file(READ "${_dir}/ffp_vs.sc" _vs_body)

# Appends the bytes of a compiled shader to _out as a C array named _name.
function(_append_array _name _file)
    file(READ "${_file}" _hex HEX)
    string(LENGTH "${_hex}" _len)
    math(EXPR _size "${_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n\t" _bytes "${_bytes}")
    set(_out "${_out}static const unsigned char ${_name}[${_size}] = {\n\t${_bytes}\n};\n\n" PARENT_SCOPE)
endfunction()

function(_compile _type _source _defines _name)
    foreach(_entry IN LISTS _backends)
        string(REPLACE ":" ";" _backend "${_entry}")
        list(GET _backend 0 _tag)
        list(GET _backend 1 _platform)
        list(GET _backend 2 _profile)
        set(_bin "${_work}/${_name}_${_tag}.bin")

        execute_process(
            COMMAND "${SHADERC}" -f "${_source}" -o "${_bin}" --type ${_type}
                --platform ${_platform} -p ${_profile} -i "${_bgfx_src}"
                --varyingdef "${_dir}/varying.def.sc" --define "${_defines}" -O 3
            RESULT_VARIABLE _result
            OUTPUT_VARIABLE _log
            ERROR_VARIABLE _log)

        if(NOT _result EQUAL 0)
            message(FATAL_ERROR "shaderc failed for ${_name} (${_tag}):\n${_log}")
        endif()

        _append_array("g_${_name}_${_tag}" "${_bin}")
        set(_out "${_out}" PARENT_SCOPE)
    endforeach()
endfunction()

set(_out "// Generated by shaders/CompileShaders.cmake from ffp_vs.sc and ffp_fs.sc. Do not edit.\n\n#pragma once\n\n")
set(_table "")

# Vertex shader variants: position (0 XYZ, 1 XYZRHW, 2 XYZB4), normal, diffuse, texture sets.
foreach(_pos RANGE 0 2)
    foreach(_normal RANGE 0 1)
        if(_pos EQUAL 1 AND _normal EQUAL 1)
            continue()
        endif()

        foreach(_color RANGE 0 1)
            foreach(_tex RANGE 0 2)
                math(EXPR _key "${_pos} | (${_normal} << 2) | (${_color} << 3) | (${_tex} << 4)")
                set(_name "ffp_vs_${_key}")

                set(_inputs "a_position")
                if(_pos EQUAL 2)
                    string(APPEND _inputs ", a_weight, a_indices")
                endif()
                if(_normal)
                    string(APPEND _inputs ", a_normal")
                endif()
                if(_color)
                    string(APPEND _inputs ", a_color0")
                endif()
                if(_tex GREATER_EQUAL 1)
                    string(APPEND _inputs ", a_texcoord0")
                endif()
                if(_tex GREATER_EQUAL 2)
                    string(APPEND _inputs ", a_texcoord1")
                endif()

                set(_xyz 0)
                set(_rhw 0)
                set(_b4 0)
                if(_pos EQUAL 0)
                    set(_xyz 1)
                elseif(_pos EQUAL 1)
                    set(_rhw 1)
                else()
                    set(_b4 1)
                endif()

                set(_source "${_work}/${_name}.sc")
                file(WRITE "${_source}" "$input ${_inputs}\n$output v_color0, v_color1, v_texcoord0, v_texcoord1, v_fog\n\n${_vs_body}")
                _compile(vertex "${_source}" "POS_XYZ=${_xyz};POS_RHW=${_rhw};POS_B4=${_b4};HAS_NORMAL=${_normal};HAS_COLOR=${_color};TEXCOUNT=${_tex}" ${_name})
                string(APPEND _table "\t{ ${_key}, g_${_name}_dx11, sizeof(g_${_name}_dx11), g_${_name}_spirv, sizeof(g_${_name}_spirv), g_${_name}_glsl, sizeof(g_${_name}_glsl) },\n")
            endforeach()
        endforeach()
    endforeach()
endforeach()

_compile(fragment "${_dir}/ffp_fs.sc" "NONE=0" ffp_fs)

string(APPEND _out "struct TFFPSHADER\n{\n\tunsigned int m_dwKey;\n\tconst unsigned char *m_pDX11;\n\tunsigned int m_nDX11;\n\tconst unsigned char *m_pSPIRV;\n\tunsigned int m_nSPIRV;\n\tconst unsigned char *m_pGLSL;\n\tunsigned int m_nGLSL;\n};\n\n")
string(APPEND _out "// Vertex shaders by key: position (0 XYZ, 1 XYZRHW, 2 XYZB4) | normal << 2 | diffuse << 3 | texture sets << 4.\n")
string(APPEND _out "static const TFFPSHADER g_vFFPVS[] = {\n${_table}};\n\n")
string(APPEND _out "static const TFFPSHADER g_vFFPFS = { 0, g_ffp_fs_dx11, sizeof(g_ffp_fs_dx11), g_ffp_fs_spirv, sizeof(g_ffp_fs_spirv), g_ffp_fs_glsl, sizeof(g_ffp_fs_glsl) };\n")

file(WRITE "${_header}" "${_out}")
message(STATUS "Wrote ${_header}")

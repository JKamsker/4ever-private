{
  "version": 6,
  "configurePresets": [
    {
      "name": "vs-x86",
      "displayName": "Visual Studio 2026, x86 (no developer shell needed)",
      "generator": "Visual Studio 18 2026",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/../build/vs-x86"
    },
    {
      "name": "msvc-x86",
      "displayName": "Ninja + MSVC, x86 (run from an x86 developer shell, see build.ps1)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/msvc-x86",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "clang-x86",
      "displayName": "Ninja + clang-cl, x86 (run from an x86 developer shell, see build.ps1)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/clang-x86",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_C_COMPILER_TARGET": "i686-pc-windows-msvc",
        "CMAKE_CXX_COMPILER_TARGET": "i686-pc-windows-msvc"
      }
    },
    {
      "name": "msvc-x64",
      "displayName": "Ninja + MSVC, x64 (run from an x64 developer shell, see build.ps1)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/msvc-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "clang-x64",
      "displayName": "Ninja + clang-cl, x64 (run from an x64 developer shell, see build.ps1)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/clang-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_C_COMPILER_TARGET": "x86_64-pc-windows-msvc",
        "CMAKE_CXX_COMPILER_TARGET": "x86_64-pc-windows-msvc"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Ninja + clang 18 + libc++, Linux x64 (bgfx), build in ~/build/tclient-linux (see build-linux.sh)",
      "generator": "Ninja",
      "binaryDir": "$env{HOME}/build/tclient-linux",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-18",
        "CMAKE_CXX_COMPILER": "clang++-18",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ --ld-path=/usr/bin/ld.lld-18"
      }
    },
    {
      "name": "clang-nod3d9-x64",
      "displayName": "Ninja + clang-cl, x64, bgfx only: no Direct3D 9 nor DirectX SDK (the Linux build's engine, on Windows)",
      "inherits": "clang-x64",
      "binaryDir": "${sourceDir}/../build/clang-nod3d9-x64",
      "cacheVariables": {
        "TCLIENT_NO_D3D9": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "vs-x86", "configurePreset": "vs-x86", "configuration": "Release" },
    { "name": "msvc-x86", "configurePreset": "msvc-x86" },
    { "name": "clang-x86", "configurePreset": "clang-x86" },
    { "name": "msvc-x64", "configurePreset": "msvc-x64" },
    { "name": "clang-x64", "configurePreset": "clang-x64" },
    { "name": "clang-nod3d9-x64", "configurePreset": "clang-nod3d9-x64" },
    { "name": "linux-clang", "configurePreset": "linux-clang" }
  ]
}
